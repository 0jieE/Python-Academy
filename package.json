{
  "name": "py-academy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "content": "tsx scripts/build-content-manifest.ts",
    "content:check": "tsx scripts/build-content-manifest.ts --check",
    "predev": "npm run content",
    "dev": "vite",
    "build": "npm run content && tsc -b && vite build && npm run search:index",
    "search:index": "tsx scripts/build-search-index.ts",
    "preview": "vite preview",
    "typecheck": "npm run content && tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:fast": "playwright test --grep-invert @slow",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.66.0",
    "pyodide": "314.0.7",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.64.1",
    "@shikijs/rehype": "^4.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gray-matter": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "oxlint": "^1.89.0",
    "pagefind": "^1.6.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "description": "Self-paced Python competitive programming tutorial site (static, Render).",
  "engines": {
    "node": ">=22.12"
  }
}
